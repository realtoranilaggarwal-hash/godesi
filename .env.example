DATABASE_URL="postgresql://godesi:godesi@localhost:5433/godesi"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payments — optional. With none of these set, checkout runs in test mode.
# Stripe (card checkout)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal (set PAYPAL_ENV=sandbox to use the sandbox API)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="live"

# Pay by UPI (India). Set the VPA to switch the option on; payments are
# confirmed manually in /admin because there is no gateway callback.
UPI_VPA=""
UPI_PAYEE_NAME="Godesi"

# Google Gemini — powers the "Ask Godesi" assistant. Without a key the chat
# widget and /api/ai/chat stay disabled. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# Public social profiles — unset handles render no footer icon.
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
NEXT_PUBLIC_SOCIAL_X=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_WHATSAPP=""

# Transactional email (Resend). EMAIL_FROM is only set once the sending domain is verified.
RESEND_API_KEY=
EMAIL_FROM="Godesi <no-reply@godesi.com>"

# Google AdSense publisher id, e.g. ca-pub-0000000000000000 (optional)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Display ad unit ids (data-ad-slot) that fill unsold placements
NEXT_PUBLIC_ADSENSE_SLOT_HERO=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_SKYSCRAPER=

# Umami Cloud analytics website id (optional); override the script host if self-hosting
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
# Umami "Share URL" for the public traffic dashboard linked in the footer (optional)
NEXT_PUBLIC_UMAMI_SHARE_URL=

# Google sign-in (console.cloud.google.com/apis/credentials -> OAuth client -> Web application)
# Authorised redirect URI: <site>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
