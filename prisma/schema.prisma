generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUSINESS
  CLIENT
  ADMIN
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum EventType {
  PROFILE_VIEW
  QR_SCAN
  WHATSAPP_CLICK
}

enum TicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BannerSlot {
  HEADER
  SIDEBAR
  SKYSCRAPER
}

enum BannerStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
}

enum AdOrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum NewsStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum LeadStatus {
  OPEN
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(BUSINESS)
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  business Business?
  leads    Lead[]
  unlocks  LeadUnlock[]
  payments Payment[]
  reviews  Review[]
  events   Event[]
  tickets  Ticket[]
  news     NewsItem[]
  banners  Banner[]
  adOrders AdOrder[]
}

/// Multi-level taxonomy: top-level categories have `parentId = null`,
/// subcategories point at their parent.
model Category {
  slug      String  @id
  name      String
  icon      String  @default("⭐")
  color     String  @default("indigo")
  blurb     String?
  sortOrder Int     @default(0)

  parentSlug String?
  parent     Category?  @relation("CategoryTree", fields: [parentSlug], references: [slug], onDelete: Cascade)
  children   Category[] @relation("CategoryTree")

  businesses    Business[] @relation("BusinessCategory")
  subBusinesses Business[] @relation("BusinessSubcategory")
  eventListings Event[]

  @@index([parentSlug, sortOrder])
}

model Business {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  category       String
  city           String
  state          String?
  description    String?
  logoUrl        String?
  websiteUrl     String?
  whatsappNumber String
  phone          String?
  publicEmail    String?
  instagramUrl   String?
  facebookUrl    String?
  youtubeUrl     String?
  mapsUrl        String?
  address        String?
  status         ListingStatus @default(PENDING)
  featured       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  categorySlug    String?
  categoryRef     Category? @relation("BusinessCategory", fields: [categorySlug], references: [slug], onDelete: SetNull)
  subcategorySlug String?
  subcategoryRef  Category? @relation("BusinessSubcategory", fields: [subcategorySlug], references: [slug], onDelete: SetNull)

  media         Media[]
  reviews       Review[]
  trackedEvents AnalyticsEvent[]
  eventListings Event[]

  @@index([category])
  @@index([city])
  @@index([categorySlug])
  @@index([subcategorySlug])
}

model Media {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  type       MediaType @default(IMAGE)
  caption    String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Analytics counter rows (profile views, QR scans, WhatsApp clicks).
model AnalyticsEvent {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       EventType
  createdAt  DateTime  @default(now())

  @@index([businessId, type])
  @@map("Event")
}

/// A public event listing with ticket booking.
model Event {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  venue       String
  city        String
  imageUrl    String?
  priceInr    Int           @default(0)
  seatsTotal  Int
  seatsBooked Int           @default(0)
  status      ListingStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizerId String
  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  categorySlug String?
  category     Category? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)

  tickets Ticket[]

  @@index([startsAt])
  @@index([categorySlug])
  @@index([city])
  @@map("EventListing")
}

model Ticket {
  id          String       @id @default(cuid())
  code        String       @unique
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerName   String
  buyerEmail  String
  buyerPhone  String?
  quantity    Int          @default(1)
  amount      Int          @default(0)
  currency    String       @default("INR")
  provider    String       @default("free")
  reference   String?      @unique
  status      TicketStatus @default(PENDING)
  checkedInAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([eventId, status])
  @@index([userId])
}

model Banner {
  id          String       @id @default(cuid())
  slot        BannerSlot   @default(SIDEBAR)
  position    Int?
  title       String
  imageUrl    String
  linkUrl     String
  active      Boolean      @default(true)
  status      BannerStatus @default(ACTIVE)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int          @default(0)
  clicks      Int          @default(0)
  createdAt   DateTime     @default(now())

  advertiserId String?
  advertiser   User?    @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  orders       AdOrder[]

  @@unique([slot, position])
  @@index([slot, active])
  @@index([advertiserId])
}

/// A paid advertising booking for one banner placement.
model AdOrder {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannerId  String?
  banner    Banner?       @relation(fields: [bannerId], references: [id], onDelete: SetNull)
  slot      BannerSlot
  months    Int           @default(1)
  amount    Int
  currency  String        @default("INR")
  provider  String        @default("stripe")
  reference String?       @unique
  status    AdOrderStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([userId, status])
}

model NewsFeed {
  id            String    @id @default(cuid())
  name          String
  url           String    @unique
  active        Boolean   @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
}

model NewsItem {
  id          String     @id @default(cuid())
  guid        String     @unique
  title       String
  summary     String
  imageUrl    String?
  link        String
  source      String
  publishedAt DateTime   @default(now())
  status      NewsStatus @default(PUBLISHED)
  createdAt   DateTime   @default(now())

  submittedById String?
  submittedBy   User?   @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model Lead {
  id           String     @id @default(cuid())
  clientId     String
  client       User       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     String
  city         String
  budgetMin    Int?
  budgetMax    Int?
  contactName  String
  contactPhone String
  contactEmail String?
  status       LeadStatus @default(OPEN)
  createdAt    DateTime   @default(now())

  unlocks LeadUnlock[]

  @@index([category])
  @@index([city])
}

model LeadUnlock {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([leadId, userId])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan
  amount    Int
  currency  String   @default("INR")
  provider  String   @default("mock")
  reference String?  @unique
  createdAt DateTime @default(now())
}
